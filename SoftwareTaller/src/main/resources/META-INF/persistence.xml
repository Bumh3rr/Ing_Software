<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">
    <persistence-unit name="Taller" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>bumh3r.model.Usuario</class>
        <class>bumh3r.model.Direccion</class>
        <class>bumh3r.model.Empleado</class>
        <class>bumh3r.model.TipoEmpleado</class>
        <class>bumh3r.model.Cliente</class>
        <class>bumh3r.model.Proveedor</class>
        <class>bumh3r.model.Refaccion</class>
        <class>bumh3r.model.Categoria</class>
        <class>bumh3r.model.Pedido</class>
        <class>bumh3r.model.DetallesPedido</class>
        <class>bumh3r.model.Nota</class>
        <class>bumh3r.model.Dispositivo</class>
        <class>bumh3r.model.Reparacion</class>
        <class>bumh3r.model.Venta</class>
        <class>bumh3r.model.DetalleVenta</class>
        <class>bumh3r.model.Pago</class>
        <class>bumh3r.model.MetodoPago</class>

        <properties>
            <!-- Configuración de la conexión a la base de datos -->
            <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:mysql://localhost:3306/taller_jpa"/>
            <property name="jakarta.persistence.jdbc.user" value="root"/>
            <property name="jakarta.persistence.jdbc.password" value="Manuelromero20@"/>

            <!--
            <property name="jakarta.persistence.jdbc.password" value="Manuelromero20@"/>
            <property name="jakarta.persistence.jdbc.password" value="maireli311"/>
            -->


            <!-- Propiedades Hibernate -->
            <property name="hibernate.dialect" value="org.hibernate.dialect.MySQLDialect"/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>

            <!-- Crear tablas automáticamente
            <property name="hibernate.hbm2ddl.auto" value="validate"/>
            -->
        </properties>
    </persistence-unit>
</persistence>